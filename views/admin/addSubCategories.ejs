<body>
  <div class="screen-overlay"></div>
  <%-include('../partials/adminAside')-%>
    <main class="main-wrap">
      <%-include('../partials/adminHeader')-%>
        <section class="content-main">
          <div class="content-header">
            <div>
              <h2 class="content-title card-title">Sub-Categories</h2>
              <p>Add, edit or delete a category</p>
            </div>
          </div>
          <div class="card">
            <div class="card-body">
              <div class="row">
                <div class="col-md-3">
                  <form method="post" action="/admin/addSubCategories">
                    <div class="mb-4">
                      <label for="product_name" class="form-label">Sub-Category Name</label>
                      <input type="text" placeholder="Type here" name="subCategoryName" class="form-control" maxlength="15"
                        id="product_name" />
                    </div>

                    <div class="mb-4">
                      <label class="form-label" name=" Description">Description</label>
                      <textarea placeholder="Type here" name="Description" class="form-control"  maxlength="30"></textarea>
                    </div>
                    <div class="d-grid">
                      <button class="btn btn-primary" type="submit">
                        Create Sub-category
                      </button>
                    </div>
                  </form>
                </div>
                <div class="col-md-9">
                  <div class="table-responsive">
                    <% if(locals.categories) { %>
                      <table class="table table-hover">
                        <thead>
                          <tr>
                            <th class="text-center">
                              <div class="form-check"></div>
                            </th>
                            <th>No</th>
                            <th>Category name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Action</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% for(let i=0 ; i < categories.length ; i++) { %>
                            <tr id="category-row-<%= categories[i]._id %>">
                              <td class="text-center">
                                <div class="form-check"></div>
                              </td>
                              <td>
                                <%= i+1 %>
                              </td>
                              <td><b>
                                  <%= categories[i].subCategoryName %>
                                </b></td>
                              <td><b>
                                  <%= categories[i].Description %>
                                </b></td>
                              <td id="status-<%= categories[i]._id %>">
                                <% if (categories[i].is_Active) { %>
                                  <span class="badge rounded-pill alert-success">Active</span>
                                <% } else { %>
                                  <span class="badge rounded-pill alert-danger">Blocked</span>
                                <% } %>
                              </td>

                              <td id="action-<%= categories[i]._id %>">
                                <a href="/admin/loadeditSubCategory?id=<%=categories[i]._id%>"
                                  class="btn btn-sm font-sm btn-light rounded"
                                  style="background-color: #007bff; color: #fff; margin-left: 5px;">
                                  <i class="material-icons md-edit"></i>
                                  Edit
                                </a>

                                <% if (categories[i].is_Active) { %>
                                  <a href="#" onclick="confirmBlock('<%= categories[i]._id %>')"
                                    class="btn btn-sm font-sm btn-light rounded block-btn"
                                    style="background-color: rgb(255, 0, 0); transition: background-color 0.3s;">
                                    <i class="material-icons md-delete_forever"></i>
                                    <b> Block</b>
                                  </a>
                                <% } else { %>
                                  <a href="#" onclick="confirmUnBlock('<%= categories[i]._id %>')"
                                    class="btn btn-sm font-sm btn-light rounded unblock-btn"
                                    style="background-color: #088178; transition: background-color 0.3s;">
                                    <i class="material-icons md-delete_forever"></i>
                                    Unblock
                                  </a>
                                <% } %>
                              </td>
                            </tr>
                          <% } %>
                        </tbody>
                      </table>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
        <footer class="main-footer font-xs">
          <div class="row pb-30 pt-15">
            <div class="col-sm-6">
              <script>
                document.write(new Date().getFullYear());
              </script>
              ©,BOOK-SAW
            </div>
            <div class="col-sm-6">
              <div class="text-sm-end">All rights reserved</div>
            </div>
          </div>
        </footer>
    </main>

    <script>
      function confirmBlock(categoryId) {
        Swal.fire({
          title: 'Are you sure?',
          text: "You are about to block this category!",
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#00d9ff',
          cancelButtonColor: '#888',
          confirmButtonText: 'Yes, block it!',
          cancelButtonText: 'No, keep it',
          background: 'rgba(30, 30, 30, 0.7)',
          color: '#fff',
          iconColor: '#f27474',
          backdrop: `
            rgba(0,0,0,0.6)
            left top
            no-repeat
          `,
          width: '900px', 
          padding: '2rem', 
          heightAuto: false, 
          height: '400px', 
          customClass: {
            popup: 'custom-swal-popup premium-modal',
            loader: 'custom-swal-loader',
          }
        }).then((result) => {
          if (result.isConfirmed) {
            // Show loading
            Swal.fire({
              title: 'Processing...',
              text: 'Please wait',
              allowOutsideClick: false,
              showConfirmButton: false,
              willOpen: () => {
                Swal.showLoading();
              }
            });

            // Make fetch request
            fetch(`/admin/ToggleblockSubCategories?catid=${categoryId}`, {
              method: 'GET',
              headers: {
                'Content-Type': 'application/json',
              }
            })
            .then(response => {
              if (!response.ok) {
                throw new Error('Network response was not ok');
              }
              return response.json().catch(() => ({})); // Handle non-JSON responses
            })
            .then(data => {
              // Update the UI
              updateCategoryStatus(categoryId, false);
              
              // Show success message
              Swal.fire({
                icon: 'success',
                title: 'Blocked!',
                text: 'Category has been blocked successfully.',
                timer: 2000,
                showConfirmButton: false
              });
            })
            .catch(error => {
              console.error('Error:', error);
              Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: 'Something went wrong. Please try again.',
              });
            });
          }
        });
      }
   
      function confirmUnBlock(categoryId) {
        Swal.fire({
          title: 'Are you sure?',
          text: "You are about to unblock this category!",
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#00d9ff',
          cancelButtonColor: '#888',
          confirmButtonText: 'Yes, unblock it!',
          cancelButtonText: 'No, keep it',
          background: 'rgba(30, 30, 30, 0.7)',
          color: '#fff',
          iconColor: '#f27474',
          backdrop: `
            rgba(0,0,0,0.6)
            left top
            no-repeat
          `,
          width: '900px', 
          padding: '2rem', 
          heightAuto: false, 
          height: '400px', 
          customClass: {
            popup: 'custom-swal-popup premium-modal',
            loader: 'custom-swal-loader',
          }
        }).then((result) => {
          if (result.isConfirmed) {
            // Show loading
            Swal.fire({
              title: 'Processing...',
              text: 'Please wait',
              allowOutsideClick: false,
              showConfirmButton: false,
              willOpen: () => {
                Swal.showLoading();
              }
            });

            // Make fetch request
            fetch(`/admin/ToggleblockSubCategories?catid=${categoryId}`, {
              method: 'GET',
              headers: {
                'Content-Type': 'application/json',
              }
            })
            .then(response => {
              if (!response.ok) {
                throw new Error('Network response was not ok');
              }
              return response.json().catch(() => ({})); // Handle non-JSON responses
            })
            .then(data => {
              // Update the UI
              updateCategoryStatus(categoryId, true);
              
              // Show success message
              Swal.fire({
                icon: 'success',
                title: 'Unblocked!',
                text: 'Category has been unblocked successfully.',
                timer: 2000,
                showConfirmButton: false
              });
            })
            .catch(error => {
              console.error('Error:', error);
              Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: 'Something went wrong. Please try again.',
              });
            });
          }
        });
      }

      // Function to update the UI dynamically
      function updateCategoryStatus(categoryId, isActive) {
        const statusCell = document.getElementById(`status-${categoryId}`);
        const actionCell = document.getElementById(`action-${categoryId}`);
        
        // Update status badge
        if (isActive) {
          statusCell.innerHTML = '<span class="badge rounded-pill alert-success">Active</span>';
        } else {
          statusCell.innerHTML = '<span class="badge rounded-pill alert-danger">Blocked</span>';
        }
        
        // Update action button
        const editButton = actionCell.querySelector('a[href*="loadeditSubCategory"]');
        const editButtonHTML = editButton.outerHTML;
        
        if (isActive) {
          actionCell.innerHTML = `
            ${editButtonHTML}
            <a href="#" onclick="confirmBlock('${categoryId}')"
              class="btn btn-sm font-sm btn-light rounded block-btn"
              style="background-color: rgb(255, 0, 0); transition: background-color 0.3s;">
              <i class="material-icons md-delete_forever"></i>
              <b> Block</b>
            </a>
          `;
        } else {
          actionCell.innerHTML = `
            ${editButtonHTML}
            <a href="#" onclick="confirmUnBlock('${categoryId}')"
              class="btn btn-sm font-sm btn-light rounded unblock-btn"
              style="background-color: #088178; transition: background-color 0.3s;">
              <i class="material-icons md-delete_forever"></i>
              Unblock
            </a>
          `;
        }
      }
    </script>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const form = document.querySelector("form[action='/admin/addSubCategories']");
        const categoryNameInput = form.querySelector("input[name='subCategoryName']");

        form.addEventListener("submit", function (event) {
          const inputValue = categoryNameInput.value.trim();

          if (inputValue === "") {
            event.preventDefault(); 
            toastr.warning("SubCategory name cannot be empty."); 
          } else if (!inputValue.replace(/\s/g, '').length) {
            event.preventDefault();
            toastr.warning("Category name cannot contain only spaces."); 
          }
        });
      });
    </script>

