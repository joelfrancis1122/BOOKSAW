<!-- ✅ JS Script -->
<script>
  async function checkCartAuth(event) {
    event.preventDefault();
    try {
      const res = await fetch("/cart", {
        method: "GET",
        headers: { "Content-Type": "application/json" },
      });

      if (res.status === 401) {
        const data = await res.json();
        toastr.error(data.message || "Please login to access your cart!");
      } else if (res.ok) {
        window.location.href = "/cart";
      } else {
        toastr.warning("Something went wrong. Try again later.");
      }
    } catch (err) {
      console.error(err);
      toastr.error("Network error! Check your connection.");
    }
  }

  // 💅 Toastr Setup
  toastr.options = {
    closeButton: true,
    progressBar: true,
    positionClass: "toast-top-right",
    timeOut: "3000",
  };
</script>