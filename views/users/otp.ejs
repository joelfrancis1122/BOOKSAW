<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>BOOKSAW | OTP Verification</title>
  <link rel="shortcut icon" type="image/x-icon" href="/public/spellbook.png">

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: "Inter", Arial, sans-serif;
      background-color: #f5f6f9;
      color: #333;
    }

    .container {
      width: 100%;
      max-width: 420px;
      padding: 20px;
    }

    .card {
      background: #ffffff;
      border-radius: 8px;
      padding: 32px 28px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    }

    h1 {
      margin: 0 0 8px;
      font-size: 22px;
      font-weight: 600;
      text-align: center;
      color: #253d4e;
    }

    .subtitle {
      text-align: center;
      font-size: 14px;
      color: #7e7e7e;
      margin-bottom: 24px;
    }

    label {
      font-size: 14px;
      font-weight: 500;
      color: #253d4e;
      display: block;
      margin-bottom: 6px;
    }

    input[type="number"] {
      width: 100%;
      padding: 12px 14px;
      font-size: 16px;
      border-radius: 6px;
      border: 1px solid #dcdcdc;
      outline: none;
      transition: border-color 0.2s ease;
    }

    input[type="number"]:focus {
      border-color: #3bb77e;
    }

    .btn {
      width: 100%;
      padding: 12px;
      border-radius: 6px;
      border: none;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .btn-primary {
      background-color: #3bb77e;
      color: #ffffff;
      margin-top: 16px;
    }

    .btn-primary:hover {
      background-color: #2fa36b;
    }

    .btn-secondary {
      background-color: transparent;
      color: #3bb77e;
      border: 1px solid #3bb77e;
      margin-top: 12px;
    }

    .btn-secondary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    #timerDisplay {
      text-align: center;
      margin-top: 14px;
      font-size: 13px;
      color: #7e7e7e;
    }

    .message {
      text-align: center;
      margin-top: 14px;
      font-size: 14px;
    }

    .error {
      color: #dc3545;
    }

    .success {
      color: #198754;
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="card">
      <h1>OTP Verification</h1>
      <div class="subtitle">
        Please enter the verification code sent to your phone
      </div>

      <form action="/verifyOtp" method="post">
        <label for="otpCode">Verification Code</label>
        <input
          type="number"
          id="otpCode"
          name="otp"
          minlength="6"
          maxlength="6"
          required
        />

        <button type="submit" class="btn btn-primary">
          Verify Code
        </button>

        <button
          type="button"
          id="resendButton"
          class="btn btn-secondary"
          onclick="resendOTP()"
          disabled
        >
          Resend OTP
        </button>

        <div id="timerDisplay"></div>

        <div class="message error">
          <%= locals.errmessage ? errmessage : '' %>
        </div>

        <div class="message success">
          <%= locals.successMessage ? successMessage : '' %>
        </div>
      </form>
    </div>
  </div>

  <script>
    let timerDuration = 10;
    let timer;

    function startTimer() {
      let seconds = timerDuration;
      document.getElementById("resendButton").disabled = true;

      timer = setInterval(() => {
        document.getElementById("timerDisplay").innerText =
          `Resend available in ${seconds}s`;

        seconds--;

        if (seconds < 0) {
          clearInterval(timer);
          document.getElementById("timerDisplay").innerText = "";
          document.getElementById("resendButton").disabled = false;
        }
      }, 1000);
    }

    function resendOTP() {
      startTimer();
      fetch("/getOtp", { method: "GET" });
    }

    window.onload = startTimer;
  </script>
</body>
</html>
